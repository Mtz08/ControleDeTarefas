# Copie para .env e preencha. O .env NUNCA vai para o git.
# Localmente, o .env aponta SOMENTE para o banco radar-dev (dados fictícios).

# Chave secreta do Django. Gere uma com:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True só no seu computador. Em produção fica ausente (False).
DEBUG=True

# Connection string DIRETA (sem "-pooler") do projeto radar-dev no Neon.
DATABASE_URL=

# Hosts aceitos, separados por vírgula. No Render, o host público é somado automaticamente.
ALLOWED_HOSTS=localhost,127.0.0.1

# Caminho do admin do Django (termine com "/"). Em produção é obrigatório e deve ser difícil de adivinhar.
ADMIN_URL=admin/

# Opcionais (os valores abaixo são os padrões):
# Proxies confiáveis na frente do app; localmente 0, no Render 1.
# PROXIES_CONFIAVEIS=0
# Meses após o encerramento para a demanda aparecer na tela de retenção.
# RETENCAO_MESES=12
# HSTS em produção, em segundos. Comece com 3600; depois de validado, 31536000.
# HSTS_SEGUNDOS=3600
